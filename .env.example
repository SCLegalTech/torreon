HOST=127.0.0.1
PORT=3000
TORREON_STATE_PATH=./data/torreon-state.json

# Dónde vive el reino: json (por defecto) | sqlite.
# `sqlite` es la persistencia real (ADR-0003): transacciones, concurrencia
# optimista y un expediente append-only SIN TECHO. Necesita Node 22.5+.
# El traslado se hace con `npm run realm:sqlite`, y no borra el documento.
# TORREON_STORE=sqlite

# Etiqueta de esta instancia. Distingue el reino local del de la nube cuando
# el Dungeon Master pregunta con cuál está hablando.
# TORREON_INSTANCE=torreon-local

# Motor del Códice: claude-cli | gemini | anthropic | heuristico.
# Sin credenciales, el Dungeon Master usa plantillas verificables.
# TORREON_CODICE=gemini
# GEMINI_API_KEY=
# TORREON_GEMINI_MODEL=gemini-3.1-pro-preview
# ANTHROPIC_API_KEY=
# TORREON_CODICE_MODEL=claude-opus-5
# TORREON_CLAUDE_BIN=

# LA LLAVE DEL REINO. Con esto definido, ninguna ruta /api responde sin
# «Authorization: Bearer <token>». Es un tapón, no una identidad: no dice quién
# llama y no se revoca por jugador. Ver docs/arquitectura/adr/0007-*.md.
# TORREON_API_TOKEN=
# La misma llave, horneada en la interfaz al compilar (apps/web).
# VITE_TORREON_API_TOKEN=

# Reiniciar el reino exige su propia llave, distinta de la de jugar. Si el reino
# está cerrado con TORREON_API_TOKEN y esta no se declara, /api/reset no existe.
# TORREON_RESET_TOKEN=

# Orígenes permitidos, separados por coma. Vacío = abierto: la APK de Capacitor
# no sirve desde este dominio y cerrarlo a ciegas la dejaría fuera.
# TORREON_ALLOWED_ORIGINS=https://torreon.fly.dev

# Protección del endpoint MCP cuando se expone fuera de loopback.
# Con token: exige Authorization: Bearer <token>.
# Con ruta secreta: la URL misma es la llave (para clientes que solo
# ofrecen "sin autenticación", como ChatGPT en modo desarrollador).
# TORREON_MCP_TOKEN=
# TORREON_MCP_PATH=/mcp/<cadena-larga-y-secreta>
